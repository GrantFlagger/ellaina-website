# InsForge project (public — safe in the browser)
NEXT_PUBLIC_INSFORGE_URL=https://nrayvzs3.eu-central.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only admin key (npx @insforge/cli secrets get API_KEY). Never prefix with NEXT_PUBLIC_.
INSFORGE_API_KEY=

# Stripe environment used by checkout: test | live
STRIPE_MODE=test

# Optional: base URL Stripe redirects back to after checkout. Defaults to
# https://www.ellainaoliveoil.com in production and http://<host> in dev.
# CHECKOUT_BASE_URL=
